# Logo CDN only — public client ID from https://developers.brandfetch.com/dashboard/keys
NEXT_PUBLIC_BRANDFETCH_CLIENT_ID=

# Leave unset. Brand API / brand fetches / brand search are intentionally not used.
# BRANDFETCH_API_KEY=

# Marketstack (server-only) — EOD prices for charts, watchlist, snapshots
MARKETSTACK_API_KEY=
# Comma-separated tickers for the daily price job. Defaults to the site watchlist.
# MARKETSTACK_REFRESH_TICKERS=VFV,META,GOOG,MSFT,AMZN,NFLX,NVDA,ASML

# SEC EDGAR fair-access User-Agent (include an email contact)
# SEC_USER_AGENT=Intrisal you@yourdomain.com

# Server-only credentials for the stock data store + auth + account watchlists.
# Also run supabase/auth-schema.sql, supabase/watchlist-schema.sql, and
# supabase/password-reset-schema.sql in the SQL editor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Resend transactional email (password reset). Verify your domain in Resend first.
# https://resend.com/api-keys  ·  https://resend.com/domains
RESEND_API_KEY=
# Example: Intrisal <noreply@intrisal.com>
EMAIL_FROM=
# Optional public HTTPS origin for logos inside emails (defaults to production if AUTH_URL is localhost).
# EMAIL_ASSET_URL=https://www.intrisal.com
# Optional rollback to the legacy EV/NOPAT series.
# INTRISAL_VALUATION_VERSION=legacy

# Required for /api/cron/edgar and /api/cron/prices.
CRON_SECRET=

# Optional dedicated secret for signed login sessions (falls back to CRON_SECRET).
# AUTH_SECRET=

# Public site origin used for Google OAuth redirects (no trailing slash).
# Local: http://localhost:3000
# Production: https://www.intrisal.com
AUTH_URL=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
